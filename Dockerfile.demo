# Lightweight public demo image (Hugging Face Spaces, Docker SDK).
# Orchestrator API + demo page only: SQLite, no OpenCTI, no SpiderFoot, no Amass.
# Keys are never baked in: NEBIUS_API_KEY, TAVILY_API_KEY, ORCHESTRATOR_API_KEY
# and ORCHESTRATOR_SECRET_KEY come from the environment (Space secrets).
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    # git: the openosint dependency is a pinned git reference.
    git \
    # libmagic1: pycti loads python-magic at import time.
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Spaces run the container as uid 1000; everything it writes lives in /app.
RUN useradd --create-home --uid 1000 app
WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
RUN mkdir -p orchestrator && touch orchestrator/__init__.py \
    && pip install --no-cache-dir ".[llm]"

COPY orchestrator/ ./orchestrator/
COPY demo/ ./demo/
RUN mkdir -p /app/data /app/daily_reports && chown -R app:app /app

USER app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEMO_MODE=true \
    OPENCTI_ENABLED=false \
    DEMO_TARGETS_FILE=demo/targets.demo.yaml \
    TARGETS_FILE=demo/targets.demo.yaml \
    ORCHESTRATOR_DATABASE_URL=sqlite+aiosqlite:////app/data/orchestrator.db \
    ORCHESTRATOR_ENV_FILE= \
    PORT=7860

EXPOSE 7860
CMD ["sh", "-c", "exec python -m uvicorn orchestrator.api:app --host 0.0.0.0 --port ${PORT}"]
