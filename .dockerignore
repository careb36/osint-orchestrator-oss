# Keep the build context to what the Dockerfiles copy. Runtime state, local
# environments and dependency trees never belong in an image.
.git
.github
**/node_modules
ui/dist
orchestrator/static/ui-dist
**/__pycache__
*.pyc
.venv
venv
.env
.env.*
*.db
*.db-journal
*.db-wal
*.db-shm
daily_reports
data
targets.yaml
amass/datasources.yaml
docs
tests
# Dockerfile.misp copies its entrypoints from deploy/misp, so excluding the
# whole tree broke that build ("entrypoint_fpm.sh: not found"). Exclude the
# rest of deploy/ but keep those two files in the context.
deploy/*
!deploy/misp
deploy/misp/*
!deploy/misp/entrypoint.sh
!deploy/misp/entrypoint_fpm.sh
scratchpad
