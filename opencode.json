{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-chat",
  "small_model": "deepseek/deepseek-chat",
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    }
  },
  "instructions": [".github/pull_request_template.md"],
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "deny"
  },
  "share": "disabled"
}
