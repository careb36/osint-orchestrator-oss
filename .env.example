# ─────────────────────────────────────────────────────────────────────────────
# OpenCTI Platform
# ─────────────────────────────────────────────────────────────────────────────
OPENCTI_ADMIN_EMAIL=admin@example.com
# Generate: openssl rand -hex 16
# required — set before first start
OPENCTI_ADMIN_PASSWORD=
# Generate: python -c "import uuid; print(uuid.uuid4())"
OPENCTI_ADMIN_TOKEN=
OPENCTI_BASE_URL=http://opencti:8080
OPENCTI_URL=http://opencti:8080               # Same as above, used by pycti
# Set false to run without OpenCTI ingest/outbox (reports, findings, delta and alerts still work)
OPENCTI_ENABLED=true
OPENCTI_SSL_VERIFY=true                       # Set false only for local/dev TLS with self-signed certs
# Ingest retry policy (transient errors only): attempts after the first one, and
# the base wait — doubled on each retry, ±25 % jitter, capped at 30 s.
OPENCTI_INGEST_RETRIES=3
OPENCTI_INGEST_BACKOFF_SECONDS=2.0
OPENCTI_OUTBOX_CRON=*/5 * * * *             # UTC cron for outbox drain worker
OPENCTI_OUTBOX_MAX_ATTEMPTS=6               # total attempts, including first ingest
OPENCTI_OUTBOX_BASE_DELAY_SECONDS=60        # exponential backoff base
OPENCTI_OUTBOX_JITTER_RATIO=0.25            # ±jitter multiplier over each delay

# Elasticsearch (≥ 4 GB heap recommended; total host RAM ≥ 16 GB for full stack)
ELASTIC_MEMORY_SIZE=4G

# ─────────────────────────────────────────────────────────────────────────────
# RabbitMQ
# ─────────────────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=orchestrator
# Generate: openssl rand -hex 16
# required — set before first start
RABBITMQ_DEFAULT_PASS=

# ─────────────────────────────────────────────────────────────────────────────
# MinIO
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=opencti
# Generate: openssl rand -hex 16
# required — set before first start
MINIO_ROOT_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# SpiderFoot
# ─────────────────────────────────────────────────────────────────────────────
SPIDERFOOT_URL=http://spiderfoot:5001         # Internal Docker network URL
SPIDERFOOT_MODULES=sfp_dnsresolve,sfp_whois,sfp_sslcert # Comma-separated list of modules to enable
SPIDERFOOT_TIMEOUT_SECONDS=600                # Collector timeout per run

# ─────────────────────────────────────────────────────────────────────────────
# OWASP Amass v5 (optional — docker-compose --profile amass)
# Enable per-target in targets.yaml: collectors.amass.enabled: true
# Data-source API keys go in amass/datasources.yaml (git-ignored), not here.
# ─────────────────────────────────────────────────────────────────────────────
AMASS_ENGINE_URL=http://amass:4000           # Engine sidecar (compose service "amass")
AMASS_DATA_DIR=/app/amass/data               # Volume shared with the engine (asset.db)
AMASS_ENUM_BIN=oam_enum                      # CLI client that submits the enumeration
AMASS_SUBS_BIN=oam_subs                      # CLI client that reads the results back
AMASS_TIMEOUT_SECONDS=1800                   # Wall-clock bound per run (enum + subs)

# ─────────────────────────────────────────────────────────────────────────────
# Tavily (optional — opt-in per target)
# Enable per-target in targets.yaml: collectors.tavily.enabled: true
# ─────────────────────────────────────────────────────────────────────────────
# Requires a Tavily API key; leave blank to disable
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic                   # basic | advanced
TAVILY_MAX_RESULTS=5                         # Global ceiling for results per query (1-20)
TAVILY_TIMEOUT_SECONDS=120                  # Wall-clock budget of a whole Tavily run per target, retries included
TAVILY_MAX_CALLS_PER_RUN=3                  # Global ceiling for search requests per run (0-20; 0 disables)
# Optional comma-separated allowlist, e.g. example.com,news.example.com
TAVILY_INCLUDE_DOMAINS=
# Optional comma-separated denylist, e.g. blog.example.com
TAVILY_EXCLUDE_DOMAINS=

# ─────────────────────────────────────────────────────────────────────────────
# Orchestrator
# ─────────────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
ORCHESTRATOR_SECRET_KEY=
# API keys (comma-separated to rotate). EMPTY = API OPEN, warning logged at startup.
# Generate: openssl rand -hex 32
ORCHESTRATOR_API_KEY=
# Inside the container /app/data is the persistent volume (docker-compose.yml).
# For a bare-metal run use e.g. sqlite+aiosqlite:///./orchestrator.db
ORCHESTRATOR_DATABASE_URL=sqlite+aiosqlite:////app/data/orchestrator.db
TARGETS_FILE=targets.yaml

# Logging: level and shape. json = one object per line for log shippers.
ORCHESTRATOR_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
ORCHESTRATOR_LOG_FORMAT=text                  # text | json
# Prometheus exposition at GET /metrics (no API key required)
ORCHESTRATOR_METRICS_ENABLED=true

# Language for operator-facing text: reports, LLM synthesis, API error details.
# Supported: es | en. Override per target with `language:` in targets.yaml.
# See docs/adr/ADR-004-language-policy.md.
ORCHESTRATOR_LANGUAGE=es

# Retention: keep run rows and daily_reports directories for this many days.
# Set to 0 to disable automatic purging entirely.
ORCHESTRATOR_RETENTION_DAYS=90
# UTC cron schedule for the nightly purge job (default: 03:30 every day).
ORCHESTRATOR_RETENTION_CRON=30 3 * * *

# ─────────────────────────────────────────────────────────────────────────────
# Human authentication (optional — compose auth overlay)
# Login entry point for operators: Keycloak + oauth2-proxy in front of the
# orchestrator. This uses localhost ports on Linux for a simple local-dev flow.
# ─────────────────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
# Generate: openssl rand -hex 16
# required — set before first start
KEYCLOAK_ADMIN_PASSWORD=
AUTH_REALM=orchestrator
AUTH_CLIENT_ID=oauth2-proxy
# Generate: openssl rand -hex 32
# required — must match the Keycloak client secret
AUTH_CLIENT_SECRET=
# Generate: openssl rand -hex 16
# required — oauth2-proxy cookie secret
AUTH_PROXY_COOKIE_SECRET=
KEYCLOAK_PORT=8085
AUTH_PROXY_PORT=8002
OIDC_ISSUER_URL=http://localhost:8085/realms/orchestrator
AUTH_REDIRECT_URL=http://localhost:8002/oauth2/callback
# Optional overrides for containerised oauth2-proxy on non-host networks.
# Browser uses LOGIN_URL; proxy backend uses *_INTERNAL_* service URLs.
OIDC_BROWSER_LOGIN_URL=http://localhost:8085/realms/orchestrator/protocol/openid-connect/auth
OIDC_INTERNAL_REDEEM_URL=http://keycloak:8080/realms/orchestrator/protocol/openid-connect/token
OIDC_INTERNAL_PROFILE_URL=http://keycloak:8080/realms/orchestrator/protocol/openid-connect/userinfo
OIDC_INTERNAL_JWKS_URL=http://keycloak:8080/realms/orchestrator/protocol/openid-connect/certs

# ─────────────────────────────────────────────────────────────────────────────
# LLM (synthesizer) — pick ONE provider
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama                           # ollama | anthropic | openai | nebius | none (synthesis off)
LLM_MODEL=llama3.2                            # Default cloud model (fallback if route-specific models are unset)
# Optional: synthesis + relationship-heavy reasoning model
LLM_MODEL_REASONING=
# Optional: lightweight classification/extraction model
LLM_MODEL_FAST=
OLLAMA_MODEL=llama3.2                         # Model for Ollama (targets with `llm: local`)
LLM_BASE_URL=http://ollama:11434              # Required for ollama; ignored for cloud
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048                           # Upper bound on the model reply
LLM_MAX_OBSERVABLES_IN_PROMPT=200
# Enable fast-route evidence qualification before synthesis
LLM_QUALIFY_ENABLED=true
# Max evidence items qualified per run (0-100; 0 disables)
LLM_QUALIFY_MAX_ITEMS=30
SYNTHESIS_HISTORY_RUNS=5
SYNTHESIS_OPENCTI_CONTEXT=false               # true = enrich synthesis with OpenCTI context
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint override
# OPENAI_BASE_URL=
# Nebius Token Factory key (LLM_PROVIDER=nebius)
# NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1  # Token Factory OpenAI-compatible endpoint

# ─────────────────────────────────────────────────────────────────────────────
# OpenOSINT (optional keys for enrichment modules)
# ─────────────────────────────────────────────────────────────────────────────
# SHODAN_API_KEY=
# VIRUSTOTAL_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# MISP (optional — -f docker-compose.misp.yml --profile misp)
# ─────────────────────────────────────────────────────────────────────────────
# URL at which MISP is reachable from the host browser (used in BASE_URL env).
MISP_BASE_URL=https://localhost:8443
# Port exposed on the host (default 8443, maps to MISP container port 443).
MISP_PORT=8443
# Admin credentials for the MISP UI (first-run initialisation).
MISP_ADMIN_EMAIL=admin@example.com
# Generate: openssl rand -hex 16
# required — minimum 12 characters
MISP_ADMIN_PASSWORD=
# MariaDB credentials for MISP's dedicated database.
# Generate: openssl rand -hex 16
# password for the `misp` DB user
MISP_MYSQL_PASSWORD=
# Generate: openssl rand -hex 16
# MariaDB root password
MISP_MYSQL_ROOT_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# connector-misp (optional — -f docker-compose.misp.yml --profile misp)
# Synchronises MISP events into OpenCTI via the official OpenCTI connector.
# Image: opencti/connector-misp:6.8.11  (must match platform version)
# See README → MISP for how to obtain MISP_KEY and verify registration.
# ─────────────────────────────────────────────────────────────────────────────
# Fixed UUID for this connector instance. Generate once per installation:
#   python -c "import uuid; print(uuid.uuid4())"
# UUID — generate before first start
CONNECTOR_MISP_ID=
# URL of MISP reachable from inside Docker (use service name https://misp — misp-core
# serves HTTPS on port 443; MISP_SSL=false and MISP_SSL_VERIFY=false skip cert verify).
MISP_URL=https://misp
# API key of the MISP admin user.
# Obtain: MISP UI → Administration → List Auth Keys → Add Authentication Key.
# MISP API key (40-char hex string)
MISP_KEY=
# Production with a real MISP certificate: set BOTH MISP_SSL and MISP_SSL_VERIFY
# to true; MISP_SSL=true alone speaks TLS but accepts any certificate.
MISP_SSL=false
MISP_SSL_VERIFY=false                    # false for the self-signed local MISP cert
MISP_IMPORT_ONLY_PUBLISHED=false         # import unpublished events too in local/dev
MISP_IMPORT_TO_IDS_NO_SCORE=40           # fallback score for attributes with to_ids=no

# ─────────────────────────────────────────────────────────────────────────────
# OWASP SocialOSINT (optional — docker-compose --profile socialosint)
# Enable per-target in targets.yaml: collectors.socialosint.enabled: true
# See docs/operations.md (Optional services) and docs/configuration.md for the
# settings and the legal notes.
# ─────────────────────────────────────────────────────────────────────────────
SOCIALOSINT_URL=http://socialosint:8000
SOCIALOSINT_TIMEOUT_SECONDS=300

# LLM — required for all analysis (OpenAI-compatible endpoint with vision).
# Use a different provider than the orchestrator's LLM if desired.
# SOCIALOSINT_LLM_BASE_URL=https://openrouter.ai/api/v1  # or https://api.openai.com/v1
# SOCIALOSINT_LLM_API_KEY=
SOCIALOSINT_LLM_MODEL=gpt-4o             # text model (must support long context)
SOCIALOSINT_LLM_VISION_MODEL=gpt-4o      # vision model (for image analysis)

# Platform credentials — omit any that you don't have; that platform is skipped.
# ⚠ X/Twitter: the developer agreement restricts storing and redistribuiting
#   user data. Keep this collector opt-in and review your use-case.
# X/Twitter v2 bearer token
# SOCIALOSINT_TWITTER_BEARER_TOKEN=

# Reddit app client ID
# SOCIALOSINT_REDDIT_CLIENT_ID=
# Reddit app client secret
# SOCIALOSINT_REDDIT_CLIENT_SECRET=
SOCIALOSINT_REDDIT_USER_AGENT=osint-orchestrator/1.0  # required by Reddit API

# GitHub PAT (optional — lower rate limit without)
# SOCIALOSINT_GITHUB_TOKEN=

# e.g. yourhandle.bsky.social
# SOCIALOSINT_BLUESKY_IDENTIFIER=
# app password (format: <xxxx-xxxx-xxxx-xxxx>)
# SOCIALOSINT_BLUESKY_APP_SECRET=

# e.g. https://mastodon.social
# SOCIALOSINT_MASTODON_INSTANCE_1_URL=
# OAuth2 access token for that instance
# SOCIALOSINT_MASTODON_INSTANCE_1_TOKEN=
# (HackerNews requires no credentials)

# ─────────────────────────────────────────────────────────────────────────────
# Webhook channel (omit ALERT_WEBHOOK_URL to disable)
# ALERT_WEBHOOK_URL=https://hooks.example.com/osint-orchestrator
# Generate: openssl rand -hex 32
# ALERT_WEBHOOK_SECRET=
ALERT_TIMEOUT_SECONDS=10

# Email channel (omit ALERT_SMTP_HOST to disable)
# ALERT_SMTP_HOST=smtp.example.com
ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=alerts@example.com
# ALERT_SMTP_PASSWORD=
# ALERT_SMTP_FROM=alerts@example.com
# ALERT_EMAIL_TO=security@example.com,ops@example.com  # comma-separated
ALERT_SMTP_STARTTLS=true

# Persistent retry queue for failed alerts
ALERT_RETRY_CRON=*/5 * * * *                # UTC cron for the retry worker
ALERT_RETRY_MAX_ATTEMPTS=4                  # total attempts, including first send
ALERT_RETRY_BASE_DELAY_SECONDS=30           # exponential backoff base
ALERT_RETRY_JITTER_RATIO=0.25               # ±jitter multiplier over each delay
